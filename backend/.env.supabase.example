# Template sem segredos para homologação temporária com Supabase + Vercel.
# Copie para backend/.env apenas em ambiente local; na Vercel, cadastre os valores nas variáveis do projeto.

APP_NAME="Controle de Brindes API"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://<dominio-da-api-vercel>
APP_TIMEZONE=America/Sao_Paulo
CORS_ALLOWED_ORIGINS=https://<dominio-do-frontend>

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
BCRYPT_ROUNDS=12
AUTH_TOKEN_EXPIRATION_MINUTES=480

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Para migrations locais, use a conexão direta ou Session Pooler.
# Para as funções da Vercel, use a mesma URI do Transaction Pooler (porta 6543).
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:6543/postgres
DB_SSLMODE=require
DB_PGSQL_DISABLE_PREPARES=true

LEGACY_JSON_PATH=../database/json

# A API usa tokens Sanctum. A tabela sessions existe para manter compatibilidade Laravel.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Modo temporário somente com banco: arquivos locais da Vercel são efêmeros.
# Para PDF/assinaturas persistentes, configure o bloco S3/Supabase Storage abaixo.
FILESYSTEM_DISK=local

# Opcional: Supabase Storage compatível com S3.
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=<supabase-s3-access-key>
# AWS_SECRET_ACCESS_KEY=<supabase-s3-secret-key>
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=<bucket-privado>
# AWS_ENDPOINT=https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
# AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"
