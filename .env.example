# Copy to .env and fill in. Never publish the .env file.

APP_NAME="Controle de Brindes"
# production | local
APP_ENV=production
APP_DEBUG=false
# Public address, without a trailing slash (include the sub-folder if installed in one)
APP_URL=https://brindes.suaempresa.com.br
APP_TIMEZONE=America/Sao_Paulo
# 64 random hex characters - generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Espelho organizado do banco para homologação/exportação (não substitui MySQL/SQLite)
JSON_DB_MIRROR=false

# Minutes of inactivity before the session expires
SESSION_IDLE_MINUTES=480

# log = write e-mails to storage/logs/mail.log (tests) | smtp = send for real
MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=brindes@suaempresa.com.br
MAIL_PASSWORD=
# tls (port 587) | ssl (port 465) | none
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=brindes@suaempresa.com.br
MAIL_FROM_NAME="Controle de Brindes"

# Lecom server-to-server API. Keep this secret outside the repository.
LECOM_API_KEY=
LECOM_HTTP_TIMEOUT=20
LECOM_CONNECT_TIMEOUT=8
